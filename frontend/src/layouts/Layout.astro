---
import "@/styles/global.css";
import FooterText from "@/components/FooterText";
import LanguagePicker from "@/components/LanguagePicker";

export interface Props {
  title?: string;
  description?: string;
  pagePattern?: "default" | "gradient";
}

const {
  title = "13TierList",
  description = "Create and share tier lists with friends. — tierlist.13room.space",
  pagePattern = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Noto+Sans+Thai:wght@300;400;500&family=Noto+Serif+Thai:wght@400;500&family=Playfair+Display:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      "min-h-screen flex flex-col",
      pagePattern === "gradient" && "pastel-canvas",
    ]}
  >
    <header class="sticky top-0 z-50 border-b border-black bg-white/92 backdrop-blur-md">
      <div
        class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
      >
        <a href="/" class="group flex items-center gap-2.5" aria-label="13TierList home">
          <span class="flex size-8 items-center justify-center bg-black text-xs font-medium tracking-[-0.08em] text-white">13</span>
          <span class="text-sm font-medium tracking-[-0.03em] sm:text-base">TIERLIST</span>
        </a>

        <div class="flex items-center gap-3">
          <LanguagePicker client:load />
          <a
            href="/create"
            class="inline-flex h-10 items-center justify-center rounded-full border border-black bg-black px-4 text-sm font-medium text-white transition-colors hover:bg-white hover:text-black"
          >
            Create&nbsp; +
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-[90rem] flex-1 px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="mt-auto border-t border-black bg-white">
      <div
        class="mx-auto max-w-[90rem] px-4 py-10 text-center text-sm font-light text-muted-foreground sm:px-6 lg:px-8"
      >
        <FooterText client:load /> &middot; 13TierList by 13room.space
      </div>
    </footer>
  </body>
</html>
