---
import CreateForm from "@/components/CreateForm";
import CreatePageIntro from "@/components/CreatePageIntro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Create Tier List — 13TierList"
  description="Create a new image-based tier list"
  pagePattern="gradient"
>
  <section class="grid min-h-[calc(100svh-10rem)] items-center gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(26rem,0.72fr)] lg:py-20">
    <CreatePageIntro client:load />
    <div class="relative">
      <div class="absolute -inset-12 -z-10 bg-[radial-gradient(circle_at_20%_40%,#ffedbe_0_12%,transparent_36%),radial-gradient(circle_at_60%_70%,#ffbcc3_0_12%,transparent_40%),radial-gradient(circle_at_80%_25%,#cdffea_0_16%,transparent_42%),radial-gradient(circle_at_90%_80%,#e7d4ff_0_16%,transparent_40%)] blur-xl"></div>
      <div class="border border-black bg-white p-6 sm:p-10">
        <p class="label-caps mb-10 flex items-center justify-between border-b border-black pb-4">
          <span>NEW LIST</span>
          <span>01</span>
        </p>
        <CreateForm client:load />
      </div>
    </div>
  </section>
</Layout>
